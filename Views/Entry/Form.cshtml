@model EntryForm

@{
    ViewData["Title"] = Model.ReportName;
}

<a asp-controller="Members"
   asp-action="Details"
   asp-route-id="@Model.MemberId">
    &larr; @Model.MemberName
</a>

<h2 class="mt-2">@Model.ReportName</h2>

<p class="text-muted">
    @Model.MemberName &middot; @Model.PackageName &middot;
    Last updated: @(Model.UpdatedOn?.ToString("dd MMM yyyy, HH:mm") ?? "not entered")
</p>

<div class="entry-search mb-4">
    <label for="testSearch" class="form-label">
        Find a test
    </label>

    <input type="search"
           id="testSearch"
           class="form-control"
           placeholder="Search by test name or code..."
           autocomplete="off"
           aria-controls="testSearchResults"
           aria-expanded="false" />

    <div id="testSearchResults"
         class="list-group mt-2"
         role="listbox"
         hidden>
    </div>

    <div class="form-text">
        Press / to search · ↑/↓ to navigate · Enter to select · Esc to close
    </div>
</div>


@if (Model.Fields.Any(f => f.Error is not null))
{
    <div class="alert alert-danger">
        Please fix the highlighted fields.
    </div>
}

<form asp-controller="Entry"
      asp-action="Form"
      asp-route-id="@Model.ReportResultId"
      method="post">

    @Html.AntiForgeryToken()

    @foreach (var f in Model.Fields)
    {
        <partial name="_Field" model="f" />
    }

    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    <script src="~/js/entry-search.js" asp-append-version="true"></script>
}
