@model EntryForm

@{
    ViewData["Title"] = Model.ReportName;
}

<a asp-controller="Members"
   asp-action="Details"
   asp-route-id="@Model.MemberId">
    &larr; @Model.MemberName
</a>

<h2 class="mt-2">@Model.ReportName</h2>
<p class="text-danger">
    DEBUG: ReportName = [@Model.ReportName]
</p>

<p class="text-muted">
    @Model.MemberName &middot; @Model.PackageName &middot;
    Last updated: @(Model.UpdatedOn?.ToString("dd MMM yyyy, HH:mm") ?? "not entered")
</p>

@{
    var invalidFields = Model.Fields
        .Where(f => !string.IsNullOrWhiteSpace(f.Error))
        .ToList();
}

@if (invalidFields.Count > 0)
{
    <div class="alert alert-danger mb-4"
         role="alert"
         aria-live="assertive"
         id="validation-summary">

        <h5 class="alert-heading">
            Please correct the following errors
        </h5>

        <p class="mb-2">
            @invalidFields.Count field(s) need your attention before you can save this report.
        </p>

        <ul class="mb-0">
            @foreach (var field in invalidFields)
            {
                <li>
                    <a class="alert-link"
                       href="#test-@field.TestCode">
                        @field.TestName: @field.Error
                    </a>
                </li>
            }
        </ul>
    </div>
}
<div class="entry-search mb-4">
    <label for="testSearch" class="form-label">
        Find a test
    </label>

    <input type="search"
           id="testSearch"
           class="form-control"
           placeholder="Search by test name or code..."
           autocomplete="off"
           aria-controls="testSearchResults"
           aria-expanded="false" />

    <div id="testSearchResults"
         class="list-group mt-2"
         role="listbox"
         hidden>
    </div>

    <div class="form-text">
        Press / to search · ↑/↓ to navigate · Enter to select · Esc to close
    </div>
</div>


@if (Model.Fields.Any(f => f.Error is not null))
{
    <div class="alert alert-danger">
        Please fix the highlighted fields.
    </div>
}

<form asp-controller="Entry"
      asp-action="Form"
      asp-route-id="@Model.ReportResultId"
      method="post"
      novalidate>

    @Html.AntiForgeryToken()

    @foreach (var f in Model.Fields)
    {
        <partial name="~/Views/Entry/_Field.cshtml" model="f" />
    }

    @if (Model.ReportName.Contains("Complete Blood Count", StringComparison.OrdinalIgnoreCase)
    || Model.ReportName.Contains("CBC", StringComparison.OrdinalIgnoreCase)
    || Model.ReportName.Contains("CBP", StringComparison.OrdinalIgnoreCase))
{
   <button type="submit"
        class="btn btn-primary"
        formaction="@Url.Action("Next", "CbcDemo", new { id = Model.ReportResultId })">
    Next
</button>
}
else
{
    <button type="submit" class="btn btn-primary">Save</button>
}
</form>

@section Scripts {
    <script src="~/js/entry-search.js" asp-append-version="true"></script>
}
